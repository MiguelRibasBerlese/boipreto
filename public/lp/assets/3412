h: 40px;\n    height: 1px;\n    background: var(--gold);\n    opacity: 0.5;\n  }\n\n  .hero-title {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: clamp(2.6rem, 5vw, 4.2rem);\n    font-weight: 300;\n    line-height: 1.15;\n    color: var(--white);\n    max-width: 780px;\n    margin-bottom: 1.8rem;\n    letter-spacing: -0.01em;\n  }\n\n  .hero-title em {\n    font-style: italic;\n    color: var(--gold-light);\n  }\n\n  .hero-sub {\n    font-size: 0.9rem;\n    font-weight: 300;\n    color: var(--white-dim);\n    max-width: 560px;\n    line-height: 1.8;\n    margin-bottom: 3rem;\n  }\n\n  .hero-cta-group {\n    display: flex;\n    align-items: center;\n    gap: 1.5rem;\n    flex-wrap: wrap;\n    justify-content: center;\n  }\n\n  .btn-primary {\n    background: var(--gold);\n    color: var(--black);\n    font-family: 'Montserrat', sans-serif;\n    font-size: 0.7rem;\n    font-weight: 700;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    padding: 1rem 2.4rem;\n    border: none;\n    cursor: pointer;\n    transition: all 0.3s ease;\n    text-decoration: none;\n    display: inline-block;\n  }\n\n  .btn-primary:hover {\n    background: var(--gold-light);\n    transform: translateY(-1px);\n  }\n\n  .btn-ghost {\n    color: var(--white-dim);\n    font-family: 'Montserrat', sans-serif;\n    font-size: 0.7rem;\n    font-weight: 400;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n    text-decoration: none;\n    border-bottom: 1px solid rgba(245,242,237,0.2);\n    padding-bottom: 2px;\n    transition: all 0.3s ease;\n  }\n\n  .btn-ghost:hover {\n    color: var(--white);\n    border-color: var(--white);\n  }\n\n  .hero-price-note {\n    margin-top: 2rem;\n    font-size: 0.72rem;\n    color: rgba(245,242,237,0.35);\n    letter-spacing: 0.05em;\n  }\n\n  \/* DIVIDER *\/\n  .divider {\n    width: 100%;\n    height: 1px;\n    background: linear-gradient(to right, transparent, rgba(187,131,28,0.3), transparent);\n    margin: 0;\n  }\n\n  \/* SECTION BASE *\/\n  section {\n    padding: 6rem 4rem;\n    max-width: 1100px;\n    margin: 0 auto;\n  }\n\n  .section-label {\n    font-size: 0.6rem;\n    font-weight: 600;\n    letter-spacing: 0.4em;\n    text-transform: uppercase;\n    color: var(--gold);\n    margin-bottom: 1.2rem;\n  }\n\n  .section-title {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: clamp(2rem, 3.5vw, 3rem);\n    font-weight: 300;\n    line-height: 1.2;\n    color: var(--white);\n    margin-bottom: 1.5rem;\n  }\n\n  .section-title em {\n    font-style: italic;\n    color: var(--gold-light);\n  }\n\n  .section-body {\n    font-size: 0.88rem;\n    color: var(--white-dim);\n    line-height: 1.9;\n    max-width: 640px;\n  }\n\n  \/* O QUE \u00c9 *\/\n  .what-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 5rem;\n    align-items: start;\n  }\n\n  .highlight-block {\n    border-left: 2px solid var(--gold);\n    padding: 1.2rem 1.5rem;\n    margin: 2rem 0;\n    background: rgba(187,131,28,0.04);\n  }\n\n  .highlight-block p {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 1.25rem;\n    font-style: italic;\n    font-weight: 300;\n    color: var(--white);\n    line-height: 1.5;\n  }\n\n  \/* INCLUSO *\/\n  .includes-list {\n    list-style: none;\n    display: flex;\n    flex-direction: column;\n    gap: 0;\n  }\n\n  .includes-list li {\n    display: flex;\n    align-items: flex-start;\n    gap: 1rem;\n    padding: 1.1rem 0;\n    border-bottom: 1px solid rgba(245,242,237,0.06);\n    font-size: 0.84rem;\n    color: var(--white-dim);\n    line-height: 1.6;\n  }\n\n  .includes-list li:last-child {\n    border-bottom: none;\n  }\n\n  .list-num {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 1.1rem;\n    font-weight: 300;\n    color: var(--gold);\n    min-width: 28px;\n    margin-top: -2px;\n  }\n\n  \/* PARA QUEM *\/\n  .criteria-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 1px;\n    background: rgba(245,242,237,0.06);\n    margin-top: 3rem;\n    border: 1px solid rgba(245,242,237,0.06);\n  }\n\n  .criteria-item {\n    background: var(--black);\n    padding: 1.8rem 2rem;\n    transition: background 0.3s;\n  }\n\n  .criteria-item:hover {\n    background: var(--black-soft);\n  }\n\n  .criteria-item p {\n    font-size: 0.84rem;\n    color: var(--white-dim);\n    line-height: 1.7;\n  }\n\n  .criteria-item p::before {\n    content: '\u2014';\n    color: var(--gold);\n    margin-right: 0.5rem;\n    font-family: 'Cormorant Garamond', serif;\n  }\n\n  \/* DEPOIMENTOS *\/\n  .testimonials-full {\n    background: var(--black-soft);\n    border-top: 1px solid rgba(187,131,28,0.15);\n    border-bottom: 1px solid rgba(187,131,28,0.15);\n  }\n\n  .testimonials-inner {\n    max-width: 1100px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 3rem;\n    padding: 5rem 4rem;\n  }\n\n  .testi-card {\n    display: flex;\n    flex-direction: column;\n    gap: 1.2rem;\n  }\n\n  .testi-quote {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 1.25rem;\n    font-style: italic;\n    font-weight: 300;\n    color: var(--white);\n    line-height: 1.55;\n  }\n\n  .testi-attr {\n    font-size: 0.68rem;\n    font-weight: 600;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: var(--gold);\n    padding-top: 0.5rem;\n    border-top: 1px solid rgba(187,131,28,0.2);\n  }\n\n  \/* GARANTIA *\/\n  .garantia-box {\n    border: 1px solid rgba(187,131,28,0.3);\n    padding: 3rem 3.5rem;\n    display: grid;\n    grid-template-columns: auto 1fr;\n    gap: 3rem;\n    align-items: center;\n    background: rgba(187,131,28,0.03);\n    margin-top: 3rem;\n  }\n\n  .garantia-icon {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 4rem;\n    font-weight: 300;\n    color: var(--gold);\n    line-height: 1;\n  }\n\n  .garantia-text h3 {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 1.6rem;\n    font-weight: 400;\n    color: var(--white);\n    margin-bottom: 0.8rem;\n  }\n\n  .garantia-text p {\n    font-size: 0.84rem;\n    color: var(--white-dim);\n    line-height: 1.8;\n  }\n\n  \/* INVESTIMENTO + FORM *\/\n  .invest-section {\n    background: var(--black-mid);\n    border-top: 1px solid rgba(187,131,28,0.12);\n  }\n\n  .invest-inner {\n    max-width: 1100px;\n    margin: 0 auto;\n    padding: 6rem 4rem;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 6rem;\n    align-items: start;\n  }\n\n  .price-display {\n    margin: 2rem 0;\n  }\n\n  .price-label {\n    font-size: 0.6rem;\n    letter-spacing: 0.3em;\n    text-transform: uppercase;\n    color: rgba(245,242,237,0.35);\n    margin-bottom: 0.4rem;\n  }\n\n  .price-value {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 4rem;\n    font-weight: 300;\n    color: var(--gold);\n    line-height: 1;\n  }\n\n  .price-desc {\n    font-size: 0.78rem;\n    color: var(--white-dim);\n    margin-top: 0.6rem;\n    line-height: 1.6;\n  }\n\n  .invest-details {\n    margin-top: 2rem;\n    display: flex;\n    flex-direction: column;\n    gap: 0;\n  }\n\n  .invest-detail-row {\n    display: flex;\n    justify-content: space-between;\n    padding: 0.7rem 0;\n    border-bottom: 1px solid rgba(245,242,237,0.06);\n    font-size: 0.8rem;\n  }\n\n  .invest-detail-row span:first-child {\n    color: rgba(245,242,237,0.4);\n    font-size: 0.72rem;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n  }\n\n  .invest-detail-row span:last-child {\n    color: var(--white);\n  }\n\n  \/* FORM *\/\n  .form-title {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 1.6rem;\n    font-weight: 300;\n    color: var(--white);\n    margin-bottom: 0.5rem;\n  }\n\n  .form-sub {\n    font-size: 0.78rem;\n    color: var(--white-dim);\n    margin-bottom: 2rem;\n    line-height: 1.6;\n  }\n\n  .form-group {\n    margin-bottom: 1rem;\n  }\n\n  .form-group label {\n    display: block;\n    font-size: 0.62